{
  "name": "vuena",
  "private": true,
  "type": "module",
  "version": "95.0.1",
  "description": "A scalable, modular ERP template built with Vue 3, Framework7, PowerSync, and Capacitor. Features offline-first architecture, real-time sync, and mobile-first design. Includes example modules and comprehensive developer tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/inventor7/Vuena.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "dev:staging": "dotenv -e build/staging/.env.staging -e .env.local -- vite",
    "dev:prod": "dotenv -e build/prod/.env.prod -e .env.local -- vite",
    "dev:generic": "dotenv -e build/generic/.env.generic -e .env.local -- vite",
    "type-check": "vue-tsc --noEmit",
    "sync-version": "node scripts/sync-version.js",
    "build": "cross-env NODE_ENV=production run-p type-check \"build-only {@}\" --",
    "build:dev": "dotenv -e build/dev/.env.dev -- vite build",
    "build:staging": "dotenv -e build/staging/.env.staging -- vite build",
    "build:prod": "dotenv -e build/prod/.env.prod -- vite build",
    "build:generic": "dotenv -e build/generic/.env.generic -- vite build",
    "build-only": "vite build",
    "preview": "vite preview --port 4173",
    "assets:dev": "npx @capacitor/assets generate --android --assetPath resources/android/dev/",
    "assets:staging": "npx @capacitor/assets generate --android --assetPath resources/android/staging",
    "assets:prod": "npx @capacitor/assets generate --android --assetPath resources/android/production/",
    "trapeze:dev": "dotenv -e build/dev/.env.dev -- trapeze run build/dev/trapeze.dev.yaml -y",
    "trapeze:staging": "dotenv -e build/staging/.env.staging -- trapeze run build/staging/trapeze.staging.yaml -y",
    "trapeze:prod": "dotenv -e build/prod/.env.prod -- trapeze run build/prod/trapeze.prod.yaml -y",
    "trapeze:generic": "dotenv -e build/generic/.env.generic -- trapeze run build/generic/trapeze.generic.yaml -y",
    "run:android:staging": "run-p build:staging && run-p trapeze:staging && npx cap run android",
    "run:android:prod": "run-p build:prod && run-p trapeze:prod && npx cap run android",
    "run:android:dev": "run-p build:dev && run-p trapeze:dev && npx cap run android",
    "run:ios:staging": "run-p build:staging && run-p trapeze:staging && npx cap run ios",
    "run:ios:prod": "run-p build:prod && run-p trapeze:prod && npx cap run ios",
    "run:ios:dev": "run-p build:dev && run-p trapeze:dev && npx cap run ios",
    "capgo:bundle:dev": "pnpm build:dev && pnpm trapeze:dev && npx cap sync && npx @capgo/cli bundle zip io.aybinv7.vuena.dev --json",
    "capgo:bundle:staging": "pnpm build:staging && pnpm trapeze:staging && npx cap sync && npx @capgo/cli bundle zip io.aybinv7.vuena.staging --json",
    "capgo:bundle:prod": "pnpm build:prod && pnpm trapeze:prod && npx cap sync && npx @capgo/cli bundle zip io.aybinv7.vuena --json",
    "capgo:bundle:generic": "pnpm build:generic && pnpm trapeze:generic && npx cap sync && npx @capgo/cli bundle zip GENERIC_APP --json",
    "capgo:upload:dev": "pnpm build:dev && pnpm trapeze:dev && npx cap sync && powershell -ExecutionPolicy Bypass -File scripts/capgo-upload.ps1 -Environment dev",
    "capgo:upload:staging": "pnpm build:staging && pnpm trapeze:staging && npx cap sync  && powershell -ExecutionPolicy Bypass -File scripts/capgo-upload.ps1 -Environment staging",
    "capgo:upload:prod": "pnpm build:prod && pnpm trapeze:prod && npx cap sync && powershell -ExecutionPolicy Bypass -File scripts/capgo-upload.ps1 -Environment prod",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:staging": "pnpm version:patch && pnpm capgo:upload:staging",
    "release:prod": "pnpm version:patch && pnpm capgo:upload:prod",
    "ship": "node scripts/deploy.js"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/file-transfer": "^1.0.6",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome-team/capacitor-file-opener": "^7.0.1",
    "@capgo/capacitor-updater": "^7.36.1",
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@openreplay/tracker": "^17.0.1",
    "@openreplay/tracker-assist": "^11.0.10",
    "@openreplay/tracker-vuex": "^4.0.3",
    "@powersync/capacitor": "^0.1.3",
    "@powersync/kysely-driver": "^1.3.1",
    "@powersync/vue": "^0.4.1",
    "@powersync/web": "^1.30.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.13.2",
    "capucho-cli": "link:../../../../AppData/Local/pnpm/global/5/node_modules/capucho-cli",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom7": "^4.0.6",
    "framework7": "^9.0.2",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^8.3.4",
    "js-logger": "^1.6.1",
    "kysely": "^0.28.9",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "skeleton-elements": "^4.0.1",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@iconify-json/f7": "^1.2.2",
    "@iconify-json/lucide": "^1.2.80",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@trapezedev/configure": "^7.1.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.25",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "less": "^4.4.2",
    "npm-run-all": "^4.1.5",
    "postcss-preset-env": "^10.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.5.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^2.3.0",
    "vite": "8.0.0-beta.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.8"
  }
}
