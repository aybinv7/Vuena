{
  "name": "vuena",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Presalio 2.0 - A modern mobile-first application built with Vue 3, Framework7, and Capacitor for cross-platform deployment",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayb/presalio-2.0.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:ios": "cross-env NODE_ENV=production vite build && npx cap copy ios",
    "build:android": "cross-env NODE_ENV=production vite build && npx cap copy android",
    "preview": "vite preview --port 4173",
    "run:android": "vite build && npx cap run android",
    "run:android:live": "vite build && npx cap run android -l ",
    "run:ios": "vite build && npx cap run ios",
    "type-check": "vue-tsc --noEmit"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@journeyapps/wa-sqlite": "^1.3.3",
    "@powersync/capacitor": "^0.1.3",
    "@powersync/kysely-driver": "^1.3.1",
    "@powersync/vue": "^0.4.1",
    "@powersync/web": "^1.29.1",
    "@supabase/supabase-js": "^2.86.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom7": "^4.0.6",
    "framework7": "^9.0.1",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^8.3.4",
    "js-logger": "^1.6.1",
    "kysely": "^0.28.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "skeleton-elements": "^4.0.1",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@iconify-json/f7": "^1.2.2",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.25",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.1.0",
    "less": "^4.4.2",
    "npm-run-all": "^4.1.5",
    "postcss-preset-env": "^10.4.0",
    "typescript": "^5.9.3",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^2.3.0",
    "vite": "8.0.0-beta.0",
    "vite-plugin-mkcert": "^1.17.9",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
